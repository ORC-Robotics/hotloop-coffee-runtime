{
  "name": "quente",
  "private": true,
  "version": "0.3.6",
  "description": "quente desktop operator console for ORC-Robotics robots.",
  "author": {
    "name": "ORC-Robotics",
    "email": "orcrobotics@users.noreply.github.com",
    "url": "https://github.com/ORC-Robotics"
  },
  "homepage": "https://github.com/ORC-Robotics/Hotloop-Coffee-Runtime",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "dev:web": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "dev:electron": "wait-on tcp:127.0.0.1:5173 && node ./scripts/start-electron.mjs",
    "desktop:dev": "concurrently -k \"npm:dev:web\" \"npm:dev:electron\"",
    "build:bridge": "node ./scripts/build-bridge.mjs",
    "build": "tsc -b && vite build",
    "build:web": "tsc -b && vite build",
    "build:desktop": "npm run build:bridge && npm run build:web && npm exec -- electron-builder",
    "pack:desktop": "npm run build:bridge && npm run build:web && npm exec -- electron-builder --dir",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "build": {
    "appId": "com.orcrobotics.orionconsole",
    "productName": "quente",
    "executableName": "quente",
    "artifactName": "${productName}-${version}.${ext}",
    "directories": {
      "output": "release"
    },
    "icon": "build/icon.ico",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "bridge-dist/",
        "to": "bridge",
        "filter": [
          "orion-telemetry-bridge*"
        ]
      },
      {
        "from": "build/icon.png",
        "to": "icon.png"
      },
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      }
    ],
    "win": {
      "target": [
        "portable"
      ],
      "signAndEditExecutable": false,
      "verifyUpdateCodeSignature": false
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "icon": "build/icon.png",
      "maintainer": "ORC-Robotics <orcrobotics@users.noreply.github.com>"
    }
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "electron": "^37.4.0",
    "electron-builder": "^26.0.12",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "tailwindcss": "^4.2.2",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.4",
    "wait-on": "^9.0.3"
  }
}
